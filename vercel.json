{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run check",
  "outputDirectory": "dist",
  "functions": {
    "api/directory.ts": { "maxDuration": 15 },
    "api/submissions.ts": { "maxDuration": 15 },
    "api/review.ts": { "maxDuration": 15 },
    "api/auth/get-session.ts": { "maxDuration": 15 },
    "api/auth/token.ts": { "maxDuration": 15 },
    "api/auth/sign-out.ts": { "maxDuration": 15 },
    "api/auth/email-otp/send-verification-otp.ts": { "maxDuration": 15 },
    "api/auth/sign-in/email-otp.ts": { "maxDuration": 15 }
  }
}
