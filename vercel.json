{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/directory.ts": { "maxDuration": 15 },
    "api/submissions.ts": { "maxDuration": 15 },
    "api/review.ts": { "maxDuration": 15 },
    "api/auth/[...path].ts": { "maxDuration": 15 }
  }
}
